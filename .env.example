# Ollama (local LLM) ------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=300
# Learned examples injected into the prompt as few-shot demos (0 = off)
EXAMPLES_IN_PROMPT=3

# Graylog (optional - API features disable when blank) ---------------
# Must include the /api prefix, e.g. http://graylog.example.com:9000/api
GRAYLOG_URL=http://graylog.example.com:9000/api
# Access token: used as HTTP Basic username with the literal password "token"
GRAYLOG_TOKEN=replace-with-your-graylog-api-token
GRAYLOG_VERIFY_SSL=true
# Offer existing Graylog field names to the model as capture-key hints (1/0)
GRAYLOG_FIELD_HINTS=true
# Cap on how many field names are injected into the prompt
GRAYLOG_FIELD_HINTS_LIMIT=300

# Server -------------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
